# ModelForge Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# --- HuggingFace ---
# Required for gated models (Llama 2, Gemma, etc.)
HF_TOKEN=

# --- Weights & Biases ---
# Required when report_to="wandb" in TrainingConfig
WANDB_API_KEY=
WANDB_PROJECT=modelforge

# --- ModelForge paths ---
MODELFORGE_LOG_DIR=./logs
MODELFORGE_OUTPUT_DIR=./outputs

# --- Server ---
PORT=8080
LOG_LEVEL=INFO
